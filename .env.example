NODE_ENV=development
APP_URL=http://localhost:8080
TZ=America/Sao_Paulo
LOG_LEVEL=info
POSTGRES_DB=apmail
POSTGRES_USER=apmail
POSTGRES_PASSWORD=troqueestasenha
DATABASE_URL=postgres://apmail:troqueestasenha@localhost:5432/apmail
DATABASE_URL_TEST=postgres://apmail:troqueestasenha@localhost:5432/apmail_test
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
ALLOW_PUBLIC_SIGNUP=true
API_PORT=3001
STORAGE_DIR=./.data/storage
MAX_UPLOAD_MB=25
SYSTEM_SMTP_HOST=localhost
SYSTEM_SMTP_PORT=1025
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_MAIL_FROM="APMail <nao-responda@apmail.local>"
WORKER_SYNC_EVERY_SECONDS=60
WORKER_RECONCILE_EVERY_MINUTES=10
WORKER_SYNC_CONCURRENCY=5
WORKER_SEND_CONCURRENCY=5
WORKER_ACTIONS_CONCURRENCY=5
WORKER_SEND_BACKOFF_MS=
STORAGE_SCAN_BATCH=5000
STORAGE_SCAN_BUDGET_MS=20000
STORAGE_PUBLISH_SECONDS=60
STORAGE_HISTORY_HOURLY_DAYS=90
STORAGE_HISTORY_DAILY_MONTHS=24
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
SYNC_DELAY_MINUTES=10
WORKER_HEARTBEAT_SECONDS=90
# Optional read-only metrics sources. Never use a Docker socket or privileged container.
BACKUP_METRICS_DIR=
LOG_METRICS_DIR=
REDIS_METRICS_DIR=
INFRA_METRICS_FILE=
ALLOW_INSECURE_TLS_HOSTS=localhost,127.0.0.1
